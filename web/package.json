{
  "name": "soma-web",
  "version": "0.11.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "SOMA in the browser: the server is the main process of the desktop app, the browser tab its window",
  "scripts": {
    "typecheck": "node ../app/node_modules/typescript/bin/tsc --noEmit -p .",
    "build": "node build.mjs",
    "start": "npm run build && node bin/soma-web.cjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test test/unit.test.mts",
    "test:server": "node --experimental-strip-types --no-warnings --test test/server.test.mts",
    "test": "npm run build && node --experimental-strip-types --no-warnings --test test/unit.test.mts test/server.test.mts"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "playwright-core": "^1.56.1"
  }
}
